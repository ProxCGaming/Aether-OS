{
  "contract": "Secret-redaction parity: the rule 'which strings are secrets' is implemented twice \u2014 aether_engine/audit.py (_SECRET_PATTERNS + _URL_CREDENTIAL_PATTERN) and desktop_app/electron/appLog.cjs (SECRET_PATTERNS + URL_CREDENTIAL_PATTERN). Both test suites (tests/test_secret_redaction_parity.py and desktop_app/electron/__tests__/appLogParity.test.js) assert their runtime list against this fixture, so a pattern added or edited on one side only fails loudly on the other. Sample strings containing a PEM header are stored as fragment arrays, split inside the header; consumers join fragments before use. This keeps synthetic samples from tripping secret scanners while decoding byte-identically.",
  "canonicalisation": "Pattern sources are stored in one canonical dialect. Each test normalises its runtime sources before comparing: '\\/' -> '/' (JS slash escaping), '\\-]' -> '-]' (a literal hyphen at the end of a character class, escaped in the Python sources), and '\\b(' -> '(\\b' (the URL pattern's word-boundary anchor sits outside the capture group in JS, inside it in Python \u2014 the group still captures the same text). Order is part of the contract: the PEM-block pattern must precede the header-only one, and the URL pattern is applied before the bare-string patterns on both sides.",
  "redacted_marker": "[REDACTED]",
  "secret_patterns": [
    {
      "id": "pem_block",
      "source": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
      "must_match": [
        [
          "-----BEGIN RSA PRIVATE ",
          "KEY-----\nSECRET_BODY_BYTES\n-----END RSA PRIVATE ",
          "KEY-----"
        ],
        [
          "-----BEGIN PRIVATE ",
          "KEY-----\nabc\n-----END PRIVATE ",
          "KEY-----"
        ]
      ],
      "must_not_match": [
        "-----BEGIN CERTIFICATE-----\nSECRET_BODY_BYTES\n-----END CERTIFICATE-----",
        [
          "-----BEGIN RSA PRIVATE ",
          "KEY-----"
        ]
      ]
    },
    {
      "id": "openai_sk",
      "source": "sk-[A-Za-z0-9_-]{8,}",
      "must_match": [
        "sk-aaaaaaaa",
        "sk-proj_Xy9-Xy9-Xy9-Xy9-Xy9-Xy9-"
      ],
      "must_not_match": [
        "sk-aaaaaaa",
        "sk-"
      ]
    },
    {
      "id": "google_api_key",
      "source": "AIza[0-9A-Za-z_-]{35}",
      "must_match": [
        "AIzaAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "AIzaaB3_-aB3_-aB3_-aB3_-aB3_-aB3_-aB3_-"
      ],
      "must_not_match": [
        "AIzaAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "AIzaAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA!"
      ]
    },
    {
      "id": "aws_access_key_id",
      "source": "(?:AKIA|ASIA)[0-9A-Z]{16}",
      "must_match": [
        "AKIAZZZZZZZZZZZZZZZZ",
        "ASIA1111111111111111"
      ],
      "must_not_match": [
        "AKIAZZZZZZZZZZZZZZZ",
        "akiaZZZZZZZZZZZZZZZZ"
      ]
    },
    {
      "id": "github_token",
      "source": "gh[pousr]_[A-Za-z0-9]{20,}",
      "must_match": [
        "ghp_aaaaaaaaaaaaaaaaaaaa",
        "ghs_BBBBBBBBBBBBBBBBBBBBBBBB"
      ],
      "must_not_match": [
        "ghp_aaaaaaaaaaaaaaaaaaa",
        "ghx_aaaaaaaaaaaaaaaaaaaa"
      ]
    },
    {
      "id": "github_pat",
      "source": "github_pat_[A-Za-z0-9_]{20,}",
      "must_match": [
        "github_pat_aaaaaaaaaaaaaaaaaaaa"
      ],
      "must_not_match": [
        "github_pat_aaaaaaaaaaaaaaaaaaa"
      ]
    },
    {
      "id": "slack_token",
      "source": "xox[baprs]-[A-Za-z0-9-]{8,}",
      "must_match": [
        "xoxb-11111111",
        "xoxp-abcd-efgh"
      ],
      "must_not_match": [
        "xoxb-1111111",
        "xozb-11111111"
      ]
    },
    {
      "id": "pem_header",
      "source": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "must_match": [
        [
          "-----BEGIN PRIVATE ",
          "KEY-----"
        ],
        [
          "-----BEGIN EC PRIVATE ",
          "KEY-----"
        ]
      ],
      "must_not_match": [
        "-----BEGIN CERTIFICATE-----",
        "-----BEGIN PRIVATE KEY----"
      ]
    }
  ],
  "url_credential_pattern": {
    "id": "url_credential",
    "source": "(\\b[a-zA-Z][a-zA-Z0-9+.-]*://[^\\s/@:]+:)[^\\s/@]+@",
    "must_match": [
      "https://alice:secretpass@api.example/v1",
      "postgres://svc:hunter2@db.internal:5432/app"
    ],
    "must_not_match": [
      "https://api.example/v1",
      "https://alice@api.example/v1",
      "ftp://alice:secretpass"
    ]
  },
  "scrub_cases": [
    {
      "input": "ordinary log text, nothing to hide",
      "expected": "ordinary log text, nothing to hide"
    },
    {
      "input": "key sk-aaaaaaaaaaaaaaaa here",
      "expected": "key [REDACTED] here"
    },
    {
      "input": [
        "prefix -----BEGIN RSA PRIVATE ",
        "KEY-----\nSECRET_BODY_BYTES\n-----END RSA PRIVATE ",
        "KEY----- suffix"
      ],
      "expected": "prefix [REDACTED] suffix"
    },
    {
      "input": [
        "-----BEGIN RSA PRIVATE ",
        "KEY-----"
      ],
      "expected": "[REDACTED]"
    },
    {
      "input": "AIzaAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expected": "[REDACTED]"
    },
    {
      "input": "AIzaAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA end",
      "expected": "AIzaAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA end"
    },
    {
      "input": "https://alice:secretpass@api.example/v1",
      "expected": "https://alice:[REDACTED]@api.example/v1"
    },
    {
      "input": "AKIAZZZZZZZZZZZZZZZZ / ghp_aaaaaaaaaaaaaaaaaaaa",
      "expected": "[REDACTED] / [REDACTED]"
    },
    {
      "input": "GET https://api.example/v1/models 200",
      "expected": "GET https://api.example/v1/models 200"
    }
  ]
}
